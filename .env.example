# Server-only values. Copy to .env locally; never commit .env.
# Use the Authorization value issued/approved for your Lantmäteriet account.
# For HTTP Basic: Basic followed by base64(username:password).
LM_AUTHORIZATION=
# Enable only products your account is entitled to use under your agreement.
LM_TOPO_ENABLED=false
LM_ORTHO_ENABLED=false
